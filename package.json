{
  "name": "pathey",
  "version": "1.0.2",
  "description": "Pathey — portable AI agent that runs from a USB drive",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js && node scripts/ensure-sqlite3.js",
    "start": "electron .",
    "electron": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@google/genai": "^1.14.0",
    "better-sqlite3": "^11.7.0",
    "chart.js": "^4.4.0",
    "dotenv": "^16.4.5",
    "msedge-tts": "^1.3.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.pathey.app",
    "productName": "Pathey",
    "files": [
      "**/*",
      "!tests/**",
      "!dist/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Pathey.exe"
    },
    "portable": {
      "artifactName": "Pathey.exe",
      "requestExecutionLevel": "user"
    }
  }
}
